# Copy to .dev.vars for `npm run dev`. Never commit .dev.vars.
# In production, set each one with: npx wrangler secret put <NAME>
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
ANGEL_API_KEY=your-smartapi-app-key
ANGEL_CLIENT_CODE=your-angel-client-id
ANGEL_MPIN=your-angel-mpin
GROWW_API_KEY=your-groww-api-key
GROWW_API_SECRET=your-groww-api-secret
